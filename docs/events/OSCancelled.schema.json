{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pos.local/events/OSCancelled.schema.json",
  "title": "OSCancelled",
  "type": "object",
  "required": ["event_id","event_name","event_version","occurred_at","correlation_id","payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_name": { "const": "OSCancelled" },
    "event_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string" },
    "saga_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["os_id"]
    }
  }
}
